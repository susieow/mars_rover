<?xml version="1.0" encoding="utf-8"?>
<!--
  mars_rover
  base_link 在六轮前后中心、黄色摆臂固定块圆孔的高度上。X 前，Y 左，Z 上，单位米。
  主摇臂绕摆臂固定块侧面的圆孔转动，轴沿 Y。弯头和中轴轴承留在 base_link 上。
  主动转向只有前轮和后轮共四个，绕 011 圆盘的孔转动。
  圆盘和它下面的轮毂安装板跟着转；伺服电机、减速机、法兰、焊接件和固定板不转。
  中间两轮没有转向，轮毂直接装在摇臂上。
  轮毂关节只带动轮毂电机和电机轴。
  每个碰撞块是一个固定子连杆，惯量盒只包住这一块。固定关节不增加自由度。
  显示网格在 ../meshes/<link>.stl，碰撞用简化几何。
  零位是六轮落地姿态：车身绕 Y 轴的安装角已含落地俯仰，左右摇臂关节在 0 rad。
  六个轮毂电机：力矩 50 N·m，转速 500 rpm（52.359878 rad/s）。
  两个摇臂：转速 1.57 rad/s。中轴轴承留在 base_link 上，摇臂用一个转动关节绕该孔转动，不再另加轴承连杆。
  关节阻尼、摩擦是轴承和减速器损耗，不是地面摩擦，也不用来平衡重力。无实测时：干摩擦取额定力矩的 2%，粘性阻尼按最高转速时阻尼力矩为额定力矩的 5% 计算。
  质量：六个轮子各 12.75 kg（合计 76.5 kg），其余结构件合计 46 kg，整车 122.5 kg。惯量按质量同比缩放。
-->
<robot name="mars_rover">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.000560" />
      <inertia ixx="3.733380e-08" ixy="0.000000e+00" ixz="0.000000e+00" iyy="3.733380e-08" iyz="0.000000e+00" izz="3.733380e-08" />
    </inertial>
    <visual name="base_link_vis">
